# The constant pad/key. Eight letters, or eight comma-separated ints in 0..25.
#   coded[i] = (25 - (password[i] + key[i])) mod 26
CRYPTEX_KEY=HOLOGRAM

# Optional. If set, a client can send {"type":"reset","token":"..."} to start
# a new puzzle after it has been solved. Leave unset to disable resets.
# CRYPTEX_ADMIN_TOKEN=change-me

# Optional. Defaults shown.
# PORT=8080
# STATIC_DIR=../frontend/dist
# RUST_LOG=info,tower_http=warn
